PORT=3000
CORS_ORIGIN=http://localhost:3002

# 请替换为随机密钥(如 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace-with-random-secret
JWT_EXPIRES_IN=12h

# 数据库连接信息必须显式配置,后端不再内置任何默认凭据 20260917 凭据收口,
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=gm_data_000

# 连接池调优(不填那么用默认值,审查修复 20261021 P2 性能):
# DB_POOL_LIMIT 并发连接上限,DB_POOL_QUEUE_LIMIT 获连等待队列上限(0=不限),
# DB_CONNECT_TIMEOUT_MS 获连超时毫秒,SLOW_QUERY_MS 慢查询告警阈值毫秒,
DB_POOL_LIMIT=20
DB_POOL_QUEUE_LIMIT=200
DB_CONNECT_TIMEOUT_MS=10000
SLOW_QUERY_MS=500

# 墓位批量新建/范围修改单次上限(排×号跨度乘积,超限直接 400 拒绝,审查修复 20261021 P1-3 / 二轮 P1-10),
ROOM_BATCH_MAX=1000

# 活跃登录态校验缓存时长毫秒(审查修复 20261021 二轮 P1-5):
# 不为每个带 token 的请求都查一次 login_session,而是按此 TTL 缓存“活跃”结论;0 等于关闭缓存,
# 登出/改密会主动失效本实例缓存,多实例部署时其他实例最多延后该时长生效,
SESSION_CHECK_CACHE_MS=5000

# 分页总数/合计复用时长毫秒(审查修复 20261021 二轮 P2-14):
# 列表接口同一筛选条件下翻页时 COUNT(*)(销售/收款查询还附带 SUM 合计)结果不会变,现按此 TTL 缓存并与取页查询并发发出;
# 任何写语句都会整体作废缓存,因此不会出现“删完数据总数还带着已删行”的长时间偏差;0 等于关闭, 20261021 新增,
COUNT_CACHE_MS=10000

# gzip 压缩阈值字节(审查修复 20261021 二轮 P2-13):墓位/业务列表一页整行 JSON 动辄数百 KB,
# 仅对“客户端声明支持 gzip + JSON/文本响应 + 2xx + 体积达阈”的响应压缩(用 node 自带 zlib,未新增依赖);
# 小于阈值的响应不压(反而多一次 CPU 与首字节延迟),置 1 等于全压,置极大值等于关闭, 20261021 新增,
GZIP_MIN_BYTES=1024

# 传输层超时毫秒(审查修复 20261021 二轮 P2-23):本服务原先一项超时都没设,一个只发请求头就停住的
# 慢连接可以按 Node 默认值(requestTimeout=300s、headersTimeout=60s)占住 socket 五分钟,
# 三项均置 0 即沿用 Node 默认值(等于不改行为,便于线上不改代码回退);
# 注意:本层只能断连接,不能中断已发出的 SQL,因此不做“响应级 504”,超时阈值应明显大于最慢正常接口,
HTTP_REQUEST_TIMEOUT_MS=60000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# 慢请求告警阈值毫秒(审查修复 20261021 二轮 P2-16 / P2-23):2xx 但耗时达阈的响应会单独记一条
# [warn][slow-request] 日志(行首带请求关联号,可与 [slow-query] 日志对齐时间线),只告警不断流;置 0 等于关闭,
SLOW_REQUEST_MS=3000

# 请求体上限与优雅停机等待毫秒(审查修复 20261021 P2,原先无文档):超上限回 413 信封,
# 停机时先停止接收新连接并排空在途请求,超过该时长则强制退出,
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# 烟雾探测凭据(审查修复 20261021 二轮 P2-20):后端不再内置任何默认账号/口令,
# 缺失时 npm run smoke 直接拒绝执行;请用一个只读权限的专用探测账号,不要用管理员账号,
# SMOKE_BASE_URL 缺省为 http://127.0.0.1:${PORT};SMOKE_RUN_MUTATION=1 才会跑写类检查(默认关),
SMOKE_USERNAME=your-smoke-account
SMOKE_PASSWORD=your-smoke-password
# SMOKE_BASE_URL=http://127.0.0.1:3000
# SMOKE_RUN_MUTATION=0

# 日期口径:后端已将 DATE/DATETIME/TIMESTAMP 统一按字符串原样返回(审查修复 20261021 一轮 P1-6),
# 字符串化依赖数据库会话时区,建议与业务时区一致并在部署侧显式设置,
# TZ=Asia/Shanghai(MYSQL 侧同步核对 system_time_zone / time_zone)